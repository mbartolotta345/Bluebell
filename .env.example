# Required for "Sign in with Google" (per-user accounts/login).
# Create an OAuth client ID at https://console.cloud.google.com/apis/credentials
#   > Create Credentials > OAuth client ID > Application type: Web application
#   Add http://127.0.0.1:5000 and http://localhost:5000 under
#   "Authorized JavaScript origins" for local development.
GOOGLE_OAUTH_CLIENT_ID=

# Required to keep users logged in across server restarts - any long random
# string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# If left blank, a random key is generated at each startup (logs everyone out
# whenever the server restarts).
SECRET_KEY=

# Powers the "care suggestion" lookup via Google Custom Search.
# GOOGLE_API_KEY: create one at https://console.cloud.google.com/apis/credentials
#   (enable the "Custom Search API" first, under APIs & Services > Library)
# GOOGLE_CSE_ID: create a search engine at https://programmablesearchengine.google.com/
#   and copy its Search Engine ID ("cx" value)
# Free for up to 100 queries/day.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Optional: SQLAlchemy database URL. Defaults to a local SQLite file if unset.
# DATABASE_URL=sqlite:///plants.db

# Optional: SMTP settings for sending real reminder emails.
# If SMTP_HOST is left blank, emails are printed to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: daily reminder job settings (used by scheduler.py / APScheduler)
REMINDER_HOUR=8
REMINDER_MINUTE=0
REALERT_INTERVAL_DAYS=3

# Set to "true" to run the daily reminder check inside the Flask app process
# via APScheduler when running app.py directly.
ENABLE_SCHEDULER=false

# Flask dev server port
PORT=5000
